{
  "name": "quantum-katas-web",
  "version": "1.0.0",
  "description": "Interactive, in-browser version of the Microsoft Quantum Katas: tutorials plus Q# exercises that run locally (WASM), no server, no login.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "convert": "node build/convert.mjs",
    "bundle": "node build/build.mjs",
    "build": "node build/convert.mjs && node build/build.mjs",
    "serve": "node tools/serve.mjs",
    "validate": "node tools/validate.mjs",
    "validate:dist": "node tools/validate-dist.mjs",
    "validate:demos": "node tools/validate-demos.mjs",
    "check:math": "node tools/check-math.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "marked-katex-extension": "^5.1.13",
    "minisearch": "^7.2.0",
    "pyodide": "^314.0.7",
    "qsharp-lang": "^1.32.5-dev"
  },
  "engines": { "node": ">=18" }
}
